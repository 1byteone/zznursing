@startuml
title 智颐养老系统 - 数据权限过滤机制

skinparam component {
  BackgroundColor #F8F8FF
  BorderColor #483D8B
  FontSize 11
  RoundCorner 8
}

rectangle "@DataScope 使用场景" as scenes {
  rectangle "SysUserServiceImpl\nselectUserList()" as userList
  rectangle "SysRoleServiceImpl\nselectRoleList()" as roleList
  rectangle "SysDeptServiceImpl\nselectDeptList()" as deptList
}

rectangle "DataScopeAspect\nAOP切面" as aspect #FFE4E1 {
  rectangle "handleDataScope()" as handle
  rectangle "dataScopeFilter()" as filter
  rectangle "clearDataScope()" as clear
}

rectangle "SysRole.dataScope\n数据权限类型" as roleType {
  rectangle "1=全部数据" as all
  rectangle "2=自定义" as custom
  rectangle "3=本部门" as dept
  rectangle "4=本部门及以下" as deptChild
  rectangle "5=仅本人" as self
}

rectangle "SQL片段拼接" as sql {
  rectangle "ALL: 无条件" as sqlAll
  rectangle "CUSTOM: dept_id IN\n(SELECT dept_id FROM\nsys_role_dept WHERE\nrole_id IN (...))" as sqlCustom
  rectangle "DEPT: dept_id =\nuser.deptId" as sqlDept
  rectangle "DEPT_AND_CHILD: dept_id IN\n(SELECT dept_id FROM\nsys_dept WHERE dept_id=\nuser.deptId OR\nfind_in_set(user.deptId,\nancestors))" as sqlDeptChild
  rectangle "SELF: user_id =\nuser.userId" as sqlSelf
}

rectangle "BaseEntity.params\n容器" as params {
  rectangle "getParams()\n.put('dataScope', sql)" as put
}

rectangle "MyBatis Mapper XML" as xml {
  rectangle "${params.dataScope}" as variable
}

userList --> aspect : @DataScope(deptAlias="d")
roleList --> aspect : @DataScope(deptAlias="d")
deptList --> aspect : @DataScope(deptAlias="d")

aspect --> handle : 非admin用户
handle --> filter : 遍历用户角色
filter --> roleType : 读取dataScope
roleType --> sql : 生成SQL片段
sql --> params : 存入params
params --> xml : ${params.dataScope}
xml --> xml : 拼接WHERE条件

note right of aspect
  执行流程:
  1. @Before拦截
  2. clearDataScope()清空
  3. 检查是否admin(userId=1)
  4. 非admin则遍历角色
  5. 按dataScope生成SQL
  6. 注入到BaseEntity
end note

note right of xml
  Mapper XML示例:
  <select>
    SELECT * FROM sys_user
    <where>
      <if test="params.dataScope">
        AND ${params.dataScope}
      </if>
    </where>
  </select>
end note

@enduml
