@startuml
title 智颐养老系统 - 用户注册流程

skinparam sequence {
  ArrowColor #2E4D7B
  ActorBorderColor #2E4D7B
  LifeLineBorderColor #2E4D7B
}

participant "用户" as user
participant "前端" as front
participant "CaptchaController" as captchaCtrl
participant "验证码服务" as captchaSvc
participant "SysRegisterController" as regCtrl
participant "SysRegisterService" as regSvc
participant "ISysConfigService" as config
participant "ISysUserService" as userSvc
participant "SecurityUtils" as sec
participant "数据库" as db

== 1. 获取验证码 ==
user -> front : 访问注册页面
front -> captchaCtrl : GET /captchaImage
captchaCtrl -> captchaSvc : 生成验证码
captchaSvc --> captchaCtrl : uuid + base64图片
captchaCtrl --> front : {uuid, img, captchaEnabled}
front --> user : 显示验证码表单

== 2. 提交注册 ==
user -> front : 填写用户名/密码/验证码
front -> regCtrl : POST /register\nRegisterBody{username,password,code,uuid}

regCtrl -> config : selectConfigByKey("sys.account.registerUser")
config --> regCtrl : true/false

alt 注册未开启
  regCtrl --> front : 当前系统没有开启注册功能
  front --> user : 提示错误
else 注册已开启
  regCtrl -> regSvc : register(registerBody)

  == 3. 校验验证码 ==
  regSvc -> regSvc : validateCaptcha(uuid, code)
  regSvc -> captchaSvc : getCacheObject(captcha_codes:{uuid})
  captchaSvc --> regSvc : storedCode
  regSvc -> captchaSvc : deleteCacheObject(captcha_codes:{uuid})
  
  alt 验证码错误
    regSvc --> regCtrl : CaptchaException
    regCtrl --> front : 验证码错误
    front --> user : 提示错误
  else 验证码正确
    == 4. 校验用户名密码 ==
    regSvc -> regSvc : 校验username不为空
    regSvc -> regSvc : 校验password不为空
    
    alt 长度不合法
      regSvc --> regCtrl : 账户/密码长度不合法
      regCtrl --> front : 提示错误
    else 长度合法
      == 5. 用户名唯一性 ==
      regSvc -> userSvc : checkUserNameUnique(username)
      userSvc --> regSvc : true/false
      
      alt 用户名已存在
        regSvc --> regCtrl : 注册账号已存在
        regCtrl --> front : 提示错误
      else 唯一性通过
        == 6. 注册用户 ==
        regSvc -> sec : encryptPassword(password)
        sec --> regSvc : 加密密码
        
        regSvc -> userSvc : registerUser(user)
        note right: 用BCrypt加密后\n插入sys_user表
        userSvc -> db : INSERT INTO sys_user
        db --> userSvc : OK
        
        userSvc --> regSvc : 成功
        regSvc -> regSvc : AsyncFactory.recordLogininfor\n异步记录注册日志
        regSvc --> regCtrl : 空字符串(成功)
        regCtrl --> front : success()
        front --> user : 注册成功提示
      end
    end
  end
end

@enduml
